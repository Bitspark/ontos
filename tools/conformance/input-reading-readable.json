{
  "description": "Cases for the conformance harness's --input-reading mode in the readable JSON profile (tools/conformance/README.md): each case runs with --json-profile readable unless it names another 'profile', and is read as docs/spec/ontos-cli.md 'JSON profiles' and docs/spec/ontos-readable-json.md say. A readable --from-json text runs through stdin, and through argv (when it fits) it must be usage_error. 'readable' pins decode --format json --json-profile readable of the case's canonical hex: the value text, or {\"error\": code}. The other fields are those of input-reading.json.",
  "profile": "readable",
  "cases": [
    {"name":"a bare integer","text":"257","expect":{"hex":"01020003696e740003000101"},"readable":"257"},
    {"name":"-0 is read as int(0) and written 0 (negative-zero)","text":"-0","expect":{"hex":"01020003696e74000100"},"readable":"0"},
    {"name":"the largest safe integer","text":"-9007199254740991","expect":{"hex":"01020003696e740008011fffffffffffff"},"readable":"-9007199254740991"},
    {"name":"null, true and false in a list","text":" [null, true,\tfalse]\n","expect":{"hex":"010400046c697374010100046e756c6c01020004626f6f6c00010101020004626f6f6c000100"},"readable":"[null,true,false]"},
    {"name":"an empty list, an empty object","text":"[[],{}]","expect":{"hex":"010300046c697374010100046c697374010100036d6170"},"readable":"[[],{}]"},
    {"name":"a text with escapes and a surrogate pair, written with the short escapes and the characters themselves","text":"\"a\\u00e9\\/\\b\\f\\n\\r\\t\\u0001\\ud83d\\ude00\"","expect":{"hex":"01020009757466382d74657874000e61c3a92f080c0a0d0901f09f9880"},"readable":"\"a\u00e9/\\b\\f\\n\\r\\t\\u0001\ud83d\ude00\""},
    {"name":"<, >, & and U+2028 are written as themselves","text":"\"<&>\\u2028\\u2029\"","expect":{"hex":"01020009757466382d7465787400093c263ee280a8e280a9"},"readable":"\"<&>\u2028\u2029\""},
    {"name":"U+FFFD in the text is an ordinary character","text":"\"\ufffd\"","expect":{"hex":"01020009757466382d746578740003efbfbd"},"readable":"\"\ufffd\""},
    {"name":"an object is a text-keyed map, written in codec order (member-order)","text":"{\"aa\":1,\"b\":[2],\"\":null}","expect":{"hex":"010400036d6170010201020009757466382d746578740000010100046e756c6c010201020009757466382d74657874000162010200046c69737401020003696e7400020002010201020009757466382d746578740002616101020003696e7400020001"},"readable":"{\"\":null,\"b\":[2],\"aa\":1}"},
    {"name":"{\"atom\":\"00\"} is a map from text to text under this profile","text":"{\"atom\":\"00\"}","expect":{"hex":"010200036d6170010201020009757466382d74657874000461746f6d01020009757466382d7465787400023030"},"readable":"{\"atom\":\"00\"}"},
    {"name":"member names spelled with escapes","text":"{\"\\u0061\":1}","expect":{"hex":"010200036d6170010201020009757466382d7465787400016101020003696e7400020001"},"readable":"{\"a\":1}"},
    {"name":"bytes tag","text":"{\"$ontos\":[\"bytes\",\"AAE=\"]}","expect":{"hex":"00020001"},"readable":"{\"$ontos\":[\"bytes\",\"AAE=\"]}"},
    {"name":"bytes tag, empty","text":"{\"$ontos\":[\"bytes\",\"\"]}","expect":{"hex":"0000"},"readable":"{\"$ontos\":[\"bytes\",\"\"]}"},
    {"name":"int tag outside the safe range","text":"{\"$ontos\":[\"int\",\"-9007199254740993\"]}","expect":{"hex":"01020003696e7400080120000000000001"},"readable":"{\"$ontos\":[\"int\",\"-9007199254740993\"]}"},
    {"name":"int tag inside the window is written bare (tagged-small-int)","text":"{\"$ontos\":[\"int\",\"5\"]}","expect":{"hex":"01020003696e7400020005"},"readable":"5"},
    {"name":"decimal tag","text":"{\"$ontos\":[\"decimal\",\"314\",\"-2\"]}","expect":{"hex":"01030007646563696d616c01020003696e74000300013a01020003696e7400020102"},"readable":"{\"$ontos\":[\"decimal\",\"314\",\"-2\"]}"},
    {"name":"set tag, sorted into codec order (entry-order)","text":"{\"$ontos\":[\"set\",[\"b\",2,1]]}","expect":{"hex":"0104000373657401020003696e740002000101020003696e740002000201020009757466382d74657874000162"},"readable":"{\"$ontos\":[\"set\",[1,2,\"b\"]]}"},
    {"name":"map tag with a key that is not text","text":"{\"$ontos\":[\"map\",[[1,\"one\"],[\"a\",true]]]}","expect":{"hex":"010300036d6170010201020003696e740002000101020009757466382d7465787400036f6e65010201020009757466382d7465787400016101020004626f6f6c000101"},"readable":"{\"$ontos\":[\"map\",[[1,\"one\"],[\"a\",true]]]}"},
    {"name":"map tag whose keys are all text is written as an object (text-keyed-map)","text":"{\"$ontos\":[\"map\",[[\"k\",1]]]}","expect":{"hex":"010200036d6170010201020009757466382d7465787400016b01020003696e7400020001"},"readable":"{\"k\":1}"},
    {"name":"compound tag","text":"{\"$ontos\":[\"compound\",\"ok\",[257]]}","expect":{"hex":"010200026f6b01020003696e740003000101"},"readable":"{\"$ontos\":[\"compound\",\"ok\",[257]]}"},
    {"name":"raw tag","text":"{\"$ontos\":[\"raw\",{\"tuple\":[{\"tuple\":[]},{\"atom\":\"00\"}]}]}","expect":{"hex":"01020100000100"},"readable":"{\"$ontos\":[\"raw\",{\"tuple\":[{\"tuple\":[]},{\"atom\":\"00\"}]}]}"},
    {"name":"raw tag of a tuple with an atom label is written as a compound, its label escaped (preferred-spelling)","text":"{\"$ontos\":[\"raw\",{\"tuple\":[{\"atom\":\"00\"}]}]}","expect":{"hex":"0101000100"},"readable":"{\"$ontos\":[\"compound\",\"\\u0000\",[]]}"},
    {"name":"raw tag of a value with another preferred spelling (preferred-spelling)","text":"{\"$ontos\":[\"raw\",{\"tuple\":[{\"atom\":\"6e756c6c\"}]}]}","expect":{"hex":"010100046e756c6c"},"readable":"null"},
    {"name":"$ontos spelled with an escape is the envelope","text":"{\"\\u0024ontos\":[\"int\",\"7\"]}","expect":{"hex":"01020003696e7400020007"},"readable":"7"},
    {"name":"an int tag of 4300 digits (the bound)","text":["{\"$ontos\":[\"int\",\"",["9",4300],"\"]}"],"expect":{"hex":""},"readable":["{\"$ontos\":[\"int\",\"",["9",4300],"\"]}"]},
    {"name":"an int tag of 4301 digits: integer_digits","text":["{\"$ontos\":[\"int\",\"",["9",4301],"\"]}"],"expect":{"error":"limit_exceeded"}},
    {"name":"a 4301-digit bare literal is an unsafe integer literal before any digit bound","text":["[",["9",4301],"]"],"expect":{"error":"invalid_json"}},
    {"name":"1024 nested lists (value depth 1024)","text":[["[",1024],["]",1024]],"expect":{"hex":[["010200046c697374",1023],"010100046c697374"]},"readable":[["[",1024],["]",1024]]},
    {"name":"1025 nested lists: decode_depth (JSON depth 1025 is within 3076)","text":[["[",1025],["]",1025]],"expect":{"error":"limit_exceeded"}},
    {"name":"3076 nested arrays: read, then refused at value depth 1025","text":[["[",3076],["]",3076]],"expect":{"error":"limit_exceeded"}},
    {"name":"3077 nested arrays: json_depth comes first","text":[["[",3077],["]",3077]],"expect":{"error":"limit_exceeded"}},
    {"name":"a fault before the 3077th level wins","text":[["[",10],"x",["[",3077]],"expect":{"error":"invalid_json"}},
    {"name":"the 3077th level comes before a later fault","text":[["[",3077],"x"],"expect":{"error":"limit_exceeded"}},
    {"name":"a fraction: invalid_number","text":"1.5","expect":{"error":"invalid_json"}},
    {"name":"an exponent: invalid_number","text":"1e3","expect":{"error":"invalid_json"}},
    {"name":"2^53 as a bare literal: unsafe_integer_literal","text":"9007199254740992","expect":{"error":"invalid_json"}},
    {"name":"$ontos with another member: invalid_envelope","text":"{\"$ontos\":[\"int\",\"5\"],\"x\":1}","expect":{"error":"invalid_json"}},
    {"name":"an empty envelope array: invalid_envelope","text":"{\"$ontos\":[]}","expect":{"error":"invalid_json"}},
    {"name":"an unknown tag: unknown_tag","text":"{\"$ontos\":[\"float\",\"1.5\"]}","expect":{"error":"invalid_json"}},
    {"name":"an int tag without its payload: invalid_tag","text":"{\"$ontos\":[\"int\"]}","expect":{"error":"invalid_json"}},
    {"name":"an int with a leading zero: invalid_integer","text":"{\"$ontos\":[\"int\",\"05\"]}","expect":{"error":"invalid_json"}},
    {"name":"an int with a plus sign: invalid_integer","text":"{\"$ontos\":[\"int\",\"+5\"]}","expect":{"error":"invalid_json"}},
    {"name":"decimal components that are not the canonical pair: noncanonical_decimal","text":"{\"$ontos\":[\"decimal\",\"10\",\"0\"]}","expect":{"error":"invalid_json"}},
    {"name":"base64 without its padding: invalid_base64","text":"{\"$ontos\":[\"bytes\",\"AAE\"]}","expect":{"error":"invalid_json"}},
    {"name":"a repeated key in a map tag: duplicate_map_key","text":"{\"$ontos\":[\"map\",[[1,\"a\"],[1,\"b\"]]]}","expect":{"error":"invalid_json"}},
    {"name":"a repeated element in a set tag: duplicate_set_element","text":"{\"$ontos\":[\"set\",[1,1]]}","expect":{"error":"invalid_json"}},
    {"name":"odd-length hex inside raw: invalid_hex","text":"{\"$ontos\":[\"raw\",{\"atom\":\"0\"}]}","expect":{"error":"invalid_json"}},
    {"name":"a repeated member name: duplicate_member","text":"{\"a\":1,\"a\":2}","expect":{"error":"invalid_json"}},
    {"name":"a repeated member name spelled with an escape","text":"{\"a\":1,\"\\u0061\":2}","expect":{"error":"invalid_json"}},
    {"name":"empty text","text":"","expect":{"error":"invalid_json"}},
    {"name":"BOM before the value","text":"\ufeff1","expect":{"error":"invalid_json"}},
    {"name":"trailing data after the value","text":"1 2","expect":{"error":"invalid_json"}},
    {"name":"form feed after the value","text":"1\f","expect":{"error":"invalid_json"}},
    {"name":"NBSP before the value","text":"\u00a01","expect":{"error":"invalid_json"}},
    {"name":"lone high surrogate escape","text":"\"\\ud800\"","expect":{"error":"invalid_json"}},
    {"name":"an unescaped control character","text":"\"\u0001\"","expect":{"error":"invalid_json"}},
    {"name":"NaN","text":"NaN","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff in a string is refused, not read as U+FFFD","bytes":"22ff22","expect":{"error":"invalid_json"}},
    {"name":"an encoded surrogate (ED A0 80) in a string is refused","bytes":"22eda08022","expect":{"error":"invalid_json"}},
    {"name":"a truncated sequence at the end is refused","bytes":"22e282","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff before the 3077th level: the UTF-8 stage comes first","bytes":"","expect":{"error":"invalid_json"}},
    {"name":"hex input: an int of more than 4300 digits, which the readable writer refuses","profile":"total","source":"hex","text":["01020003696e7400fb0d00",["ff",1786]],"expect":{"hex":["01020003696e7400fb0d00",["ff",1786]]},"readable":{"error":"limit_exceeded"}},
    {"name":"hex input: a text, rendered by the readable writer","source":"hex","text":"01020009757466382d7465787400026869\n","expect":{"hex":"01020009757466382d7465787400026869"},"readable":"\"hi\""},
    {"name":"--json-profile total is the default, given explicitly","profile":"total","text":"{\"atom\":\"00\"}","expect":{"hex":"000100"}}
  ]
}
