{
  "description": "Cases for the conformance harness's --from-json-reading mode (tools/conformance/README.md): each is an input text and the outcome docs/spec/ontos-cli.md 'Value input' gives it under canon --emit. 'source' is 'json' (the default: the --from-json text) or 'hex' (the hex input). 'text' is the text, either a string or a list of pieces, each a string or a [string, count] pair to repeat; 'bytes' is the text as hex, for input that is not UTF-8. 'via' limits the case to 'argv' or 'stdin' (default: both, argv when the text fits). 'expect' is the canonical hex (in the same piece form) or the error code.",
  "cases": [
    {"name":"trailing ] after the value","text":"{\"atom\":\"00\"}]","expect":{"error":"invalid_json"}},
    {"name":"trailing } after the value","text":"{\"atom\":\"00\"}}","expect":{"error":"invalid_json"}},
    {"name":"a second value after the value","text":"{\"atom\":\"00\"} {\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"trailing ] after a tuple","text":"{\"tuple\":[]}]","expect":{"error":"invalid_json"}},
    {"name":"space, tab, LF, CR around and between tokens","text":" \t\n\r{ \t\n\r\"tuple\" \t\n\r: \t\n\r[ {\"atom\":\"00\"} , {\"atom\":\"\"} ] } \t\n\r","expect":{"hex":"01020001000000"}},
    {"name":"LF after the value (a shell's echo)","text":"{\"atom\":\"00\"}\n","expect":{"hex":"000100"}},
    {"name":"CRLF after the value","text":"{\"atom\":\"00\"}\r\n","expect":{"hex":"000100"}},
    {"name":"form feed after the value","text":"{\"atom\":\"00\"}\f","expect":{"error":"invalid_json"}},
    {"name":"form feed before the value","text":"\f{\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"vertical tab between tokens","text":"{\"atom\":\u000b\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"NBSP after the value","text":"{\"atom\":\"00\"}\u00a0","expect":{"error":"invalid_json"}},
    {"name":"NEL (U+0085) after the value","text":"{\"atom\":\"00\"}\u0085","expect":{"error":"invalid_json"}},
    {"name":"LINE SEPARATOR (U+2028) after the value","text":"{\"atom\":\"00\"}\u2028","expect":{"error":"invalid_json"}},
    {"name":"IDEOGRAPHIC SPACE (U+3000) before the value","text":"\u3000{\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"BOM before the value","text":"\ufeff{\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"empty text","text":"","expect":{"error":"invalid_json"}},
    {"name":"whitespace only","text":" \n","expect":{"error":"invalid_json"}},
    {"name":"\\u escapes in the atom's hex","text":"{\"atom\":\"\\u0030\\u0030\"}","expect":{"hex":"000100"}},
    {"name":"\\u escapes in the member name, either hex case","text":"{\"\\u0061\\u0074\\u006F\\u006d\":\"00\"}","expect":{"hex":"000100"}},
    {"name":"every short escape is read (the cap comes next)","text":["[","\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"",",",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"a surrogate pair is read (the cap comes next)","text":["[","\"\\ud83d\\ude00\"",",",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"lone high surrogate escape in the atom","text":"{\"atom\":\"\\ud800\"}","expect":{"error":"invalid_json"}},
    {"name":"lone high surrogate escape: a text fault, before the cap","text":["[","\"\\ud800\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"lone low surrogate escape: a text fault, before the cap","text":["[","\"\\udc00\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"high surrogate escape, then a non-surrogate escape: before the cap","text":["[","\"\\ud800\\u0041\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"surrogate escapes in the wrong order: before the cap","text":["[","\"\\ude00\\ud83d\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"lone surrogate escape in a member name","text":"{\"\\ud800\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"unknown escape: a text fault, before the cap","text":["[","\"\\x41\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"unescaped control character: a text fault, before the cap","text":["[","\"\u0001\"",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"atom repeated with the same value","text":"{\"atom\":\"00\",\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"atom repeated with another value","text":"{\"atom\":\"01\",\"atom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"tuple repeated","text":"{\"tuple\":[],\"tuple\":[]}","expect":{"error":"invalid_json"}},
    {"name":"atom repeated, spelled with an escape","text":"{\"atom\":\"00\",\"\\u0061tom\":\"00\"}","expect":{"error":"invalid_json"}},
    {"name":"a repeated name inside a tuple","text":"{\"tuple\":[{\"atom\":\"00\",\"atom\":\"00\"}]}","expect":{"error":"invalid_json"}},
    {"name":"a repeated name: a text fault, before the cap","text":["{","\"x\":1,\"x\":2",",\"tail\":",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"a repeated name spelled with an escape: before the cap","text":["{","\"x\":1,\"\\u0078\":2",",\"tail\":",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"two distinct names: a shape fault, after the cap","text":["{","\"x\":1",",\"tail\":",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"atom and tuple are two members","text":"{\"atom\":\"00\",\"tuple\":[]}","expect":{"error":"invalid_json"}},
    {"name":"NaN: a text fault, before the cap","text":["[","NaN",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"Infinity: a text fault, before the cap","text":["[","Infinity",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"-Infinity: a text fault, before the cap","text":["[","-Infinity",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"a 5000-digit integer is read for grammar only (the cap comes next)","text":["[",["7",5000],",",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"fraction and exponent are read (the cap comes next)","text":["[","-0.5e+10",",",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"true, false and null are read (the cap comes next)","text":["[","true,false,null",",",["[",2050]],"expect":{"error":"limit_exceeded"}},
    {"name":"a number with a leading zero: a text fault, before the cap","text":["[","01",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"a truncated literal: a text fault, before the cap","text":["[","tru",",",["[",2050]],"expect":{"error":"invalid_json"}},
    {"name":"a number as the value","text":"0","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff in a string is read as U+FFFD (the cap comes next)","bytes":"","expect":{"error":"limit_exceeded"}},
    {"name":"an encoded surrogate (ED A0 80) in a string is read as U+FFFD (the cap comes next)","bytes":"","expect":{"error":"limit_exceeded"}},
    {"name":"byte 0xff in the atom","bytes":"7b2261746f6d223a22ff227d","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff in a member name","bytes":"7b226174ff6f6d223a223030227d","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff after the value","bytes":"7b2261746f6d223a223030227dff","expect":{"error":"invalid_json"}},
    {"name":"byte 0xff outside a string: a text fault, before the cap","bytes":"","expect":{"error":"invalid_json"}},
    {"name":"a hex argument with byte 0xff","source":"hex","bytes":"ff","via":["argv"],"expect":{"error":"invalid_hex"}},
    {"name":"a hex argument with byte 0xff after valid hex","source":"hex","bytes":"303030313030ff","via":["argv"],"expect":{"error":"invalid_hex"}},
    {"name":"1024 tuples around an atom (nested 1024 deep)","text":[["{\"tuple\":[",1024],"{\"atom\":\"00\"}",["]}",1024]],"expect":{"hex":[["0101",1024],"000100"]}},
    {"name":"1025 tuples, the innermost empty (nested 1024 deep, 2050 levels)","text":[["{\"tuple\":[",1025],["]}",1025]],"expect":{"hex":[["0101",1024],"0100"]}},
    {"name":"1025 tuples around an atom (nested 1025 deep)","text":[["{\"tuple\":[",1025],"{\"atom\":\"00\"}",["]}",1025]],"expect":{"error":"limit_exceeded"}},
    {"name":"1026 tuples, the innermost empty (nested 1025 deep, 2052 levels)","text":[["{\"tuple\":[",1026],["]}",1026]],"expect":{"error":"limit_exceeded"}},
    {"name":"2050 nested arrays: read, then refused by the shape","text":[["[",2050],["]",2050]],"expect":{"error":"invalid_json"}},
    {"name":"3000 nested arrays: the cap comes first","text":[["[",3000],["]",3000]],"expect":{"error":"limit_exceeded"}},
    {"name":"a fault before the 2051st level wins","text":[["[",10],"x",["[",3000]],"expect":{"error":"invalid_json"}},
    {"name":"data after the value comes before any deep bracket","text":["{\"atom\":\"00\"}",["[",3000]],"expect":{"error":"invalid_json"}},
    {"name":"the 2051st level comes before a later fault","text":[["[",2051],"x"],"expect":{"error":"limit_exceeded"}},
    {"name":"10^5 tuples around an atom (1.2 MB on stdin)","text":[["{\"tuple\":[",100000],"{\"atom\":\"00\"}",["]}",100000]],"expect":{"error":"limit_exceeded"}},
    {"name":"10^6 open brackets, never closed (1 MB on stdin)","text":[["[",1000000]],"expect":{"error":"limit_exceeded"}},
    {"name":"a 1 MiB atom (2 MB in, 2 MB out)","text":["{\"atom\":\"",["ab",1048576],"\"}"],"expect":{"hex":["00808040",["ab",1048576]]}}
  ]
}
